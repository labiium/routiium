# Routiium — Example .env
# Copy this file to `.env` and adjust values for your environment.
# All values are optional unless noted. Lines starting with `#` are comments.

###############################################################################
# Server
###############################################################################

# Address the HTTP server binds to (host:port).
BIND_ADDR=0.0.0.0:8088

# Compose mounts this host YAML file to /config/routiium.yaml and sets
# ROUTIIUM_CONFIG_YAML inside the container. Copy routiium.yaml.example to
# routiium.yaml and set this path when you want a local editable config.
# ROUTIIUM_CONFIG_YAML_HOST=./routiium.yaml

# Logging (tracing) configuration.
# Example levels: error,warn,info,debug,trace
RUST_LOG=info,tower_http=info


###############################################################################
# Admin and privileged runtime surfaces
###############################################################################

# REQUIRED for admin endpoints. Without this, admin APIs fail closed.
ROUTIIUM_ADMIN_TOKEN=change-me-admin-token

# Only for throwaway local development; never enable in production.
# ROUTIIUM_INSECURE_ADMIN=0

# MCP config updates can spawn local commands through configured MCP servers, so
# runtime MCP config writes are disabled unless explicitly enabled.
# ROUTIIUM_ALLOW_MCP_CONFIG_UPDATE=0

# /convert is safe by default and does not merge internal prompts/MCP metadata.
# Add ?include_internal_config=true with admin auth to inspect the full internal conversion.
# ROUTIIUM_PUBLIC_CONVERT_INTERNAL_CONFIG=0

###############################################################################
# Upstream (OpenAI or compatible)
###############################################################################

# REQUIRED for /proxy to contact a real upstream.
# Do NOT commit real keys; use placeholders locally.
# OPENAI_API_KEY=sk-your-key

# Base URL for upstream API.
# Default (if unset): https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional upstream mode override. Defaults to `responses`.
# Set to `chat`, `bedrock`, or `bedrock_mantle` for another upstream adapter.
# ROUTIIUM_UPSTREAM_MODE=chat

# Default models used by integration tests / clients (optional).
# MODEL=gpt-4.1-nano
# CHAT_MODEL=gpt-4.1-nano

# Built-in router + judge defaults. Leave enabled for safe-by-default routing.
ROUTIIUM_ROUTER_MODE=embedded
ROUTIIUM_ROUTER_STRICT=1
ROUTIIUM_ROUTER_PRIVACY_MODE=full
ROUTIIUM_JUDGE_MODE=protect
ROUTIIUM_RESPONSE_GUARD=protect
ROUTIIUM_STREAMING_SAFETY=chunk
ROUTIIUM_JUDGE_LLM=auto
ROUTIIUM_JUDGE_SENSITIVE_TARGET=secure
ROUTIIUM_JUDGE_ON_DENY=block
ROUTIIUM_REJECTION_MODE=agent_result
ROUTIIUM_WEB_JUDGE=restricted

# Optional provider-neutral typed-decision routing. OpenRouter and TypeSafe
# receive the same `model`/`state`/`questions` body. The Router still validates
# selected IDs against its own healthy, capable model catalog.
# ROUTIIUM_DECISION_PROVIDER=openrouter
# ROUTIIUM_DECISION_API_KEY_ENV=OPENROUTER_API_KEY
# ROUTIIUM_DECISION_MODEL=typesafe/jev-1.13
# ROUTIIUM_DECISION_ENDPOINT=https://openrouter.ai/api/alpha/decisions
# For TypeSafe direct, use `typesafe`, `TYPESAFE_API_KEY`, and `jev-1.13.0`.
# ROUTIIUM_DECISION_TIMEOUT_MS=1000
# ROUTIIUM_DECISION_ROUTE_ALIASES=auto,routiium-auto,openai-multimodal,default
# ROUTIIUM_DECISION_STRICT=0
# ROUTIIUM_DECISION_CATALOG_TTL_MS=60000
# ROUTIIUM_DECISION_PRIVACY_MODE=features

# Optional typed-decision request judge. This uses the same provider/model
# contract; deterministic checks and local safety policy remain active.
# ROUTIIUM_JUDGE_DECISION_PROVIDER=openrouter
# ROUTIIUM_JUDGE_DECISION_MODEL=typesafe/jev-1.13
# ROUTIIUM_JUDGE_API_KEY_ENV=OPENROUTER_API_KEY
# ROUTIIUM_JUDGE_DECISION_ENDPOINT=https://openrouter.ai/api/alpha/decisions
# ROUTIIUM_JUDGE_DECISION_MIN_CONFIDENCE=0.65
# ROUTIIUM_JUDGE_DECISION_CATEGORY_THRESHOLD=0.5

# Legacy Jevai model-route integration remains available when the generic
# ROUTIIUM_DECISION_PROVIDER setting is unset.
# JEV_API_KEY=jev-your-key
# ROUTIIUM_JEV_API_KEY_ENV=JEV_API_KEY
# ROUTIIUM_JEV_BASE_URL=https://www.jevai.org
# ROUTIIUM_JEV_TIMEOUT_MS=750
# ROUTIIUM_JEV_STRICT=0
# ROUTIIUM_JEV_CATALOG_TTL_MS=60000
# ROUTIIUM_JEV_PRIVACY_MODE=features

# Optional custom judge policy/prompt overlay. Generate with:
# routiium judge policy init --out config/judge-policy.json
# ROUTIIUM_JUDGE_POLICY_PATH=./config/judge-policy.json
# Optional durable safety audit log for router denials and response-guard blocks.
# ROUTIIUM_SAFETY_AUDIT_PATH=./data/safety-audit.jsonl
# ROUTIIUM_SAFETY_AUDIT_MAX_EVENTS=1000

# Set ROUTIIUM_ROUTER_MODE=off only if you explicitly want legacy routing.

###############################################################################
# CORS (Cross-Origin Resource Sharing)
# Defaults are same-origin only when unset. Set explicit values for browser clients.
###############################################################################

# Allowed origins:
# - Comma-separated list: "https://a.example.com, https://b.example.com"
# - "*" allows any origin; prefer CORS_ALLOW_ALL=1 for explicit local-only opt-in
# CORS_ALLOWED_ORIGINS=https://yourapp.example.com
# CORS_ALLOW_ALL=0

# Allowed HTTP methods. Unset means Actix default behavior; set for browsers.
# CORS_ALLOWED_METHODS=GET,POST,OPTIONS

# Allowed request headers. Unset means Actix default behavior; set for browsers.
# CORS_ALLOWED_HEADERS=content-type,authorization

# Allow credentials (cookies, auth headers) — enable cautiously:
# truthy values: 1,true,yes,on
# CORS_ALLOW_CREDENTIALS=0

# Preflight max-age in seconds (browser caches OPTIONS response).
# CORS_MAX_AGE=600

###############################################################################
# Production CORS example (uncomment and customize)
###############################################################################
# CORS_ALLOWED_ORIGINS=https://yourapp.example.com
# CORS_ALLOWED_METHODS=GET,POST,OPTIONS
# CORS_ALLOWED_HEADERS=content-type,authorization
# CORS_ALLOW_CREDENTIALS=1
# # CORS_MAX_AGE=600
# Native coding-client subscription proxying. Prefer:
#   routiium subscription setup --client claude
# Claude defaults to the public Anthropic API. Codex requires an explicitly
# authorized upstream.
# ROUTIIUM_CLAUDE_SUBSCRIPTION_BASE_URL=https://api.anthropic.com
# ROUTIIUM_CODEX_SUBSCRIPTION_BASE_URL=https://your-authorized-codex-upstream.example
# ROUTIIUM_SUBSCRIPTION_LOG_PATH=./data/subscription_usage.jsonl
# ROUTIIUM_SUBSCRIPTION_MAX_REQUEST_BYTES=67108864
# Set a positive byte count to cap captured request/response bodies; unset/0 logs all bytes.
# ROUTIIUM_SUBSCRIPTION_LOG_MAX_BODY_BYTES=16777216
